# Copy to .env and fill in. .env is git-ignored.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
MOSAIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
MOSAIC_EFFORT=high
# Lets Claude use Anthropic's server-side web_search / web_fetch to reach the
# NIH repositories that have no dedicated connector.
MOSAIC_ENABLE_WEB_TOOLS=true
# deferred = connector tools are discovered through tool search (recommended)
# eager    = every connector tool is sent on every request
MOSAIC_TOOL_LOADING=deferred
# Server-side refusal fallback: default | off
MOSAIC_FALLBACKS=default
# Model / effort for extract_structured (defaults: MOSAIC_MODEL, low)
MOSAIC_EXTRACTION_MODEL=
MOSAIC_EXTRACTION_EFFORT=low
# Figure Studio ("graph generation" folder) that draws the mind map and charts as SVG / PNG / PDF.
# Empty = look for a "graph generation" folder next to this Mosaic folder.
MOSAIC_FIGUREGEN_PATH=
# Optional API server settings: comma-separated extra Host headers / CORS origins
MOSAIC_ALLOWED_HOSTS=
MOSAIC_CORS_ORIGINS=

# Contact email for Crossref / Unpaywall / OpenAlex polite pools.
BIOPHA_CONTACT_EMAIL=

# --- Keyed sources ---
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
ELSEVIER_SCOPUS_API_KEY=
ELSEVIER_INSTTOKEN=
SPRINGER_OPENACCESS_API_KEY=
SPRINGER_META_API_KEY=
OPENFDA_API_KEY=
CLARIVATE_API_KEY=

# --- DrugCentral public read-only PostgreSQL ---
DRUGCENTRAL_PG_HOST=unmtid-dbs.net
DRUGCENTRAL_PG_PORT=5433
DRUGCENTRAL_PG_DBNAME=drugcentral
DRUGCENTRAL_PG_USER=drugman
DRUGCENTRAL_PG_PASSWORD=dosage

# --- Application ---
BIOPHA_DATA_DIR=./data
BIOPHA_AUDIT_DB=./data/audit.db
BIOPHA_CACHE_DB=./data/cache.db
# seconds; 0 disables the HTTP response cache
BIOPHA_CACHE_TTL=21600
BIOPHA_HTTP_TIMEOUT=30
BIOPHA_LOG_LEVEL=INFO
BIOPHA_API_HOST=127.0.0.1
BIOPHA_API_PORT=8000
