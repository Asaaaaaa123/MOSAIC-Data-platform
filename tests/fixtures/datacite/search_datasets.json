    "descriptions": [
     {
      "descriptionType": "Abstract",
      "description": "This dataset contains processed transcriptomic inputs, analysis code, numerical results, exploratory prognostic-model data and fitted objects, myeloid-estimator sensitivity analyses, supplementary methods and tables, and two supplied Western blot source images accompanying the study “Cellular distribution and myeloid context of FCER1G in glioblastoma”. Public source datasets include TCGA-GBM, CGGA"
     }
