    "descriptions": [
     {
      "descriptionType": "Abstract",
      "description": "\"Background: Multi-omics and single-cell data vary substantially in format and scale, challenging robust annotation across datasets and platforms. We hypothesized that within-sample molecular feature ranks provide stable information about tissue and cell identity. We developed a rank-based transformation, standardized normal distribution (SND), and evaluated its performance across omics modalities"
     }
